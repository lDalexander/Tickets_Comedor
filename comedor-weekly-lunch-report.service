[Unit]
Description=Reporte semanal acumulado de tiempo de almuerzo (correo SMTP)
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=oneshot
User=john
WorkingDirectory=/home/john/comedor/Tickets_Comedor/backend/python_core
ExecStart=/home/john/comedor/Tickets_Comedor/backend/python_core/venv/bin/python send_weekly_lunch_report.py

# Salida a journald: revisar con `journalctl -u comedor-weekly-lunch-report`
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
