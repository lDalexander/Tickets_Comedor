# SERVICIO REEMPLAZADO POR NGINX
#
# El servidor de desarrollo Vite ya no se usa en producción.
# Nginx sirve los archivos estáticos de frontend/dist/ directamente.
#
# Para deshabilitar este servicio:
#   sudo systemctl stop comedor-frontend
#   sudo systemctl disable comedor-frontend
#
# Para desarrollo local (sin Nginx):
#   cd frontend && npm run dev

[Unit]
Description=Comedor Frontend Vite — SOLO DESARROLLO (produccion usa Nginx)
After=network.target

[Service]
Type=simple
User=john
WorkingDirectory=/home/john/comedor/Tickets_Comedor/frontend
ExecStart=/usr/bin/npm run dev -- --host 0.0.0.0
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target multi-user.target
