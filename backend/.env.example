# Plantilla de variables de entorno — copiar a /etc/comedor/secrets.env con valores reales
# Los valores reales NUNCA deben entrar al repositorio

PORT=5002
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=control_comedor
NODE_ENV=production

# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ADMIN_JWT_SECRET=

LOG_PATH=/var/log/comedor/backend-errors.log

# Separar múltiples orígenes con coma. Ejemplo: http://150.36.200.x:5173,http://150.36.200.x:3000
CORS_ORIGINS=
