[Unit]
Description=Comedor Tickets System
After=network.target

[Service]
Type=forking
User=john
WorkingDirectory=/home/john/comedor/Tickets_Comedor
ExecStart=/home/john/comedor/Tickets_Comedor/start_system.sh
ExecStop=/usr/bin/pkill -f "node server.js"; /usr/bin/pkill -f "python comedor.py"
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
