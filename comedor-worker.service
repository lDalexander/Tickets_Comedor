[Unit]
Description=Comedor Worker (Python)
After=network.target mysql.service

[Service]
Type=simple
User=john
WorkingDirectory=/home/john/comedor/Tickets_Comedor/backend_comedor
# Use the venv python
ExecStart=/home/john/comedor/Tickets_Comedor/backend_comedor/venv/bin/python -u comedor.py
Restart=always
RestartSec=5

# Output to journald
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target multi-user.target
